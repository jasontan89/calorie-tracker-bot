# Telegram Bot Token from @BotFather
CALORIE_BOT_TOKEN=your_telegram_bot_token_here

# Secret token for authenticating Telegram Webhook requests (generate with openssl rand -hex 32)
TELEGRAM_SECRET_TOKEN=your_random_telegram_webhook_secret_here

# Secret token for triggering recurring cron jobs (midday, night, weekly, fasting)
CRON_SECRET=your_random_cron_secret_here

# Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase URL and Service Role Key (for connecting from the Edge Function / Client)
# Note: These are automatically injected by Supabase inside Edge Functions, but
# you may want them here for local testing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
